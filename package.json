{
  "name": "causent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"lib/**/*.test.ts\"",
    "db:reset-demo": "bash scripts/reset-local-demo.sh",
    "check:release-config": "node scripts/check-release-config.mjs app",
    "check:recompute-config": "node scripts/check-release-config.mjs worker",
    "check:resolve-config": "node scripts/check-release-config.mjs resolver",
    "check:drift-config": "node scripts/check-release-config.mjs drift",
    "check:dashboard-build": "node scripts/check-dashboard-build.mjs",
    "check:query-plans": "bash scripts/check-hot-query-plans.sh",
    "test:load-contract": "node --test load/contract.test.mjs",
    "load:smoke": "CAUSENT_LOAD_ACK=I_UNDERSTAND_STAGING_LOAD CAUSENT_LOAD_ENV=local CAUSENT_LOAD_PROFILE=smoke k6 run load/causent-mvp.js",
    "load:inspect": "CAUSENT_LOAD_ACK=I_UNDERSTAND_STAGING_LOAD CAUSENT_LOAD_ENV=local CAUSENT_LOAD_PROFILE=smoke k6 inspect load/causent-mvp.js",
    "scale:plan": "python3 engine/persistence/scale_fixture.py --profile gigabyte"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "ai": "^7.0.34",
    "htmlparser2": "12.0.0",
    "next": "^16.2.11",
    "pdf-parse": "2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "undici": "8.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.12",
    "sharp": "$sharp",
    "ws": "8.21.0"
  }
}
